# Local environment and secrets
.env
.env.*
.venv/
venv/
*.pem
*.key
service-account*.json

# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/

# Workshop run-time output (rendered templates, agent.env with the engine
# principal, the registered agent card, deploy logs). Regenerated by scripts.
scripts/rendered/

# Editors and OS
.DS_Store
.idea/
.vscode/

# Companion "Vitae Vault" art generator, prompt pack, and masters: local only,
# unrelated to the cloud build
companion-art/
art/

# Maintainer-only notes (review record, publishing procedure): never pushed
maintainer/

# The learner-facing codelab (codelab.md, deep-dive.md, build.py, img/) is
# distributed separately from the code repository that Cloud Shell clones.
# Keep it next to the code locally, but never push it. Because this folder is
# ignored, `git clean -x` WOULD DELETE IT; use `git clean` without -x.
codelab/

